# Cakap environment variables
# Copy this file to `.env.local` (which is gitignored) and fill in your keys.
# Tip: with the Vercel<>Supabase integration you can run `vercel env pull .env.local`
# to fetch these locally instead of pasting them by hand.

# --- AI provider ---
# Which provider powers conversations: "groq" (default) or "gemini".
AI_PROVIDER=groq

# Model id for the active provider.
#   Groq:   llama-3.3-70b-versatile (recommended) | llama-3.1-8b-instant | gemma2-9b-it
#   Gemini: gemini-2.0-flash | gemini-2.5-flash
AI_MODEL=llama-3.3-70b-versatile

# Groq API key from https://console.groq.com/keys  (required when AI_PROVIDER=groq)
GROQ_API_KEY=

# Google Gemini API key from https://aistudio.google.com/app/apikey
# (required only when AI_PROVIDER=gemini)
GEMINI_API_KEY=

# Max messages a single user may send per day (Gemini quota protection).
DAILY_MESSAGE_LIMIT=100

# --- Supabase (auth + database) ---
# Public — safe to expose to the browser (protected by Row-Level Security).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — NEVER expose to the browser. Used for admin invites & usage writes.
SUPABASE_SERVICE_ROLE_KEY=

# Base URL used for invite/redirect links (e.g. http://localhost:3000 locally,
# or your production URL on Vercel).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
