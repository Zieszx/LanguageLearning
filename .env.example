# Cakap environment variables
# Copy this file to `.env.local` (which is gitignored) and fill in your key.

# --- AI provider ---
# Which provider powers conversations: "gemini" or "groq". Default: gemini
AI_PROVIDER=gemini

# Model id for the active provider.
#   gemini -> gemini-2.0-flash
#   groq   -> llama-3.3-70b-versatile
AI_MODEL=gemini-2.0-flash

# Google Gemini API key from https://aistudio.google.com/app/apikey
# Required when AI_PROVIDER=gemini.
GEMINI_API_KEY=

# Groq API key from https://console.groq.com/keys
# Required when AI_PROVIDER=groq.
GROQ_API_KEY=

# --- Supabase (auth + per-user data sync) ---
# Find these in Supabase: Project Settings -> API.
# The URL and the browser key MUST start with NEXT_PUBLIC_ so the client can
# read them. The "publishable" (new) or "anon" (classic) key is browser-safe.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Or, if you use classic keys:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
